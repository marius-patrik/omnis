{
  "$comment": "Everything about this repository that the shared pipeline needs and cannot detect. The pipeline lives in marius-patrik/DarkFactory and is pinned below; the workflows here are callers, not copies.",
  "identity": {
    "owner": "marius-patrik",
    "repo": "omnis",
    "display_name": "Omnis",
    "project_title": "Omnis",
    "agent_slug": "omnis-agent",
    "description": "Omnis - universal developer workspace and local-first personal data OS. Multi-process Rust daemon, Tauri shell, dual renderer (DOM + terminal cell-grid), multi-agent harness orchestration.",
    "topics": [
      "agentic-coding",
      "agentic-development",
      "ai-agents",
      "autonomous-agents",
      "automation",
      "developer-tools",
      "local-first",
      "rust",
      "tauri",
      "terminal-ui",
      "workspace"
    ]
  },
  "upstream": {
    "$comment": "The shared pipeline. `ref` is the pin: bump it to adopt a pipeline update, and the diff shows exactly what changed.",
    "repo": "marius-patrik/DarkFactory",
    "ref": "f0d838e891c73656952ca18bc49a8cae871dfed5"
  },
  "versioning": {
    "mode": "zerover",
    "tag_prefix": "v",
    "initial": "0.1.0"
  },
